{
    "version": "2.2.8",
    "description": "一个简约的第三方酷狗音乐概念版 | A simple third-party KuGou Concept Music",
    "homepage": "https://github.com/hoowhoami/EchoMusic",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/hoowhoami/EchoMusic/releases/download/v2.2.8/EchoMusic-2.2.8-Windows-Setup-x64.exe",
            "hash": "7a182e007f7d24bce1eb18297d2104bbd720cf386cb8d87f0bf67a16606138cb"
        }
    },
    "installer": {
        "script": "cmd /c \"`\"$fname`\" /S /D=`\"$dir`\"\""
    },
    "post_install": [
        "# 创建 persist 目录的 AppData junction（让 Electron 应用无感读写 persist 数据）",
        "foreach ($pair in @(@('echo-music', \"$env:APPDATA\\echo-music\"), @('echo-music-nodejs', \"$env:APPDATA\\echo-music-nodejs\"))) {",
        "    $src = \"$persist_dir\\$($pair[0])\"",
        "    $tgt = $pair[1]",
        "    if (!(Test-Path $src)) { New-Item -ItemType Directory $src -Force | Out-Null }",
        "    if (Test-Path $tgt) {",
        "        if ((Get-Item $tgt).LinkType -ne 'Junction') {",
        "            # 首次迁移：将已有数据移入 persist",
        "            Get-ChildItem $tgt | Move-Item -Destination $src -Force",
        "            Remove-Item $tgt -Force",
        "        } else {",
        "            Remove-Item $tgt -Force -Recurse",
        "        }",
        "    }",
        "    New-Item -ItemType Junction -Path $tgt -Target $src -Force | Out-Null",
        "}"
    ],
    "pre_uninstall": [
        "# 终止进程",
        "Stop-Process -Name 'EchoMusic' -Force -ErrorAction SilentlyContinue",
        "# 移除 AppData 端的 junction（保留 persist 数据）",
        "foreach ($tgt in @(\"$env:APPDATA\\echo-music\", \"$env:APPDATA\\echo-music-nodejs\")) {",
        "    if ((Test-Path $tgt) -and ((Get-Item $tgt).LinkType -eq 'Junction')) {",
        "        Remove-Item $tgt -Force -Recurse",
        "    }",
        "}",
        "# 清理更新器缓存",
        "Remove-Item \"$env:LOCALAPPDATA\\echo-music-updater\" -Force -Recurse -ErrorAction SilentlyContinue",
        "# 运行 NSIS 卸载程序",
        "if (Test-Path \"$dir\\app\\Uninstall EchoMusic.exe\") {",
        "    cmd /c \"`\"$dir\\app\\Uninstall EchoMusic.exe`\" /S\"",
        "}"
    ],
    "shortcuts": [
        [
            "app\\EchoMusic.exe",
            "EchoMusic"
        ]
    ],
    "persist": [
        "echo-music",
        "echo-music-nodejs"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/hoowhoami/EchoMusic/releases/download/v$version/EchoMusic-$version-Windows-Setup-x64.exe"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
