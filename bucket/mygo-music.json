{
    "version": "0.1.24",
    "description": "A native music player you extend with plugins",
    "homepage": "https://github.com/egoist/mygo-music",
    "license": "AGPL-3.0",
    "notes": "User data is persisted through a junction at '%APPDATA%\\MyGo Music' and survives updates and uninstalls.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v0.1.24/mygo-music-0.1.24-windows-amd64.tar.gz",
            "hash": "27f4ae76de758ad2fb4f1bd83001f6fd2ef764352a630705bd6f2a0a842e19b6"
        },
        "arm64": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v0.1.24/mygo-music-0.1.24-windows-arm64.tar.gz",
            "hash": "fe12b9412af2d8606253e598438baa46b154503a46002356d8029b82804e097d"
        }
    },
    "shortcuts": [
        [
            "MyGo Music.exe",
            "MyGo Music"
        ]
    ],
    "pre_install": [
        "Write-Host ''",
        "$dataDir = \"$env:APPDATA\\MyGo Music\"",
        "New-Item -Path $persist_dir -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "$existingItem = Get-Item -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue",
        "if ($existingItem -and ($existingItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "    if ($existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq $persist_dir) {",
        "        return",
        "    }",
        "    throw \"Cannot persist MyGo Music data: '$dataDir' is an unsupported link or points to another directory.\"",
        "}",
        "if ($existingItem -and !$existingItem.PSIsContainer) {",
        "    throw \"Cannot persist MyGo Music data: '$dataDir' is not a directory.\"",
        "}",
        "if ($existingItem) {",
        "    info \"Moving MyGo Music data from '$dataDir' to '$persist_dir'...\"",
        "    Get-ChildItem -LiteralPath $dataDir -Force -ErrorAction Stop | Move-Item -Destination $persist_dir -ErrorAction Stop",
        "    [IO.Directory]::Delete($dataDir)",
        "}",
        "info \"Creating MyGo Music data junction from '$dataDir' to '$persist_dir'...\"",
        "New-Item -Path $dataDir -ItemType Junction -Target $persist_dir -ErrorAction Stop | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Write-Host ''",
            "    $dataDir = \"$env:APPDATA\\MyGo Music\"",
            "    $existingItem = Get-Item -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue",
            "    if ($existingItem -and ($existingItem.LinkType -eq 'Junction') -and ($existingItem.Target -eq $persist_dir)) {",
            "        info \"Removing MyGo Music data junction at '$dataDir'...\"",
            "        [IO.Directory]::Delete($dataDir)",
            "    }",
            "    if ($purge) {",
            "        $localDataDirs = @(\"$env:LOCALAPPDATA\\MyGo\", \"$env:LOCALAPPDATA\\MyGo Music\")",
            "        foreach ($localDataDir in $localDataDirs) {",
            "            info \"Removing MyGo Music local data at '$localDataDir'...\"",
            "            Remove-Item -LiteralPath $localDataDir -Recurse -Force -ErrorAction SilentlyContinue",
            "        }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/egoist/mygo-music"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/mygo-music/releases/download/v$version/mygo-music-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/egoist/mygo-music/releases/download/v$version/mygo-music-$version-windows-arm64.tar.gz"
            }
        },
        "hash": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v$version/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
