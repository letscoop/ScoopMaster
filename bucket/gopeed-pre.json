            "hash": "9da449539349e22be9b810de237c381a5a609e545a5408676ca5f2ff816575cb"
        },
        "arm64": {
            "url": "https://github.com/GopeedLab/gopeed/releases/download/v2.0.0-beta.1/Gopeed-v2.0.0-beta.1-windows-arm64.exe",
