    },
    "pre_install": "Get-ChildItem \"$dir\" 'Gopeed*.exe' | Rename-Item -NewName 'setup.exe'",
    "installer": {
        "script": [
            "Start-Process -Wait \"$dir\\setup.exe\" -ArgumentList @('/SP-', '/VERYSILENT', '/PORTABLE', \"/DIR=`\"$dir`\"\")",
            "Remove-Item \"$dir\\setup.exe\""
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart"
        ]
    },
    "bin": "gopeed.exe",
    "shortcuts": [
        [
            "gopeed.exe",
            "Gopeed"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/GopeedLab/gopeed/releases",
        "jp": "$[*].tag_name",
        "regex": "v([\\d.]+-[\\w.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GopeedLab/gopeed/releases/download/v$version/Gopeed-v$version-windows-amd64.exe"
