{
    "version": "2026.2.4.1-262.11879.106",
    "description": "Cross-Platform IDE for C and C++ by JetBrains.",
    "homepage": "https://www.jetbrains.com/cpp/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "notes": [
        "Add CLion to the right-click menu by running:",
        "reg import \"$dir\\install-context.reg\""
    ],
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "url": "https://download.jetbrains.com/cpp/CLion-2026.2.4.1.win.zip",
    "hash": "86116f5f066797e610d450a17b60714402be13be3a2dfe606b9633c348b04a38",
    "bin": [
        [
            "IDE\\bin\\clion64.exe",
            "clion"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\clion64.exe",
            "CLion"
        ]
    ],
    "extract_to": "IDE",
    "pre_install": [
        "# The JetBrains Daemon lives outside the app folder (%LOCALAPPDATA%\\JetBrains\\Daemon) and",
        "# holds bundles, cache, data and logs. Redirect it into 'persist' so it survives updates and",
        "# stays off the system drive.",
        "# Please keep the folder list the same in both pre_install and uninstaller scripts.",
        "$daemon = \"$env:LOCALAPPDATA\\JetBrains\\Daemon\"",
        "$target = \"$persist_dir\\Daemon\"",
        "$item = Get-Item -Path $daemon -Force -ErrorAction Ignore",
        "if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "    # Our own junction from a previous install; recreate it against the current version.",
        "    [IO.Directory]::Delete($daemon)",
        "} elseif ($item) {",
        "    if (!(Test-Path \"$target\")) {",
        "        Write-Host \"Migrating '$daemon' to persist directory...\" -ForegroundColor Yellow",
        "        New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null",
        "        Move-Item -Path $daemon -Destination $target -Force",
        "    } else {",
        "        $backup = \"Daemon.bak-$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Write-Host \"Persist data already exists, '$daemon' renamed to '$backup'.\" -ForegroundColor Yellow",
        "        Rename-Item -Path $daemon -NewName $backup",
        "    }",
        "}",
        "if (!(Test-Path \"$target\")) { New-Item \"$target\" -ItemType Directory -Force | Out-Null }",
        "if (!(Test-Path \"$env:LOCALAPPDATA\\JetBrains\")) { New-Item \"$env:LOCALAPPDATA\\JetBrains\" -ItemType Directory -Force | Out-Null }",
        "New-Item -Path $daemon -ItemType Junction -Value $target | Out-Null"
    ],
    "installer": {
        "script": [
            "# Portable mode: redirect config/system/plugins/log into the app directory so that",
            "# 'persist' can pick them up. Inlined instead of relying on extras/scripts/jetbrains,",
            "# so this manifest does not break if that bucket changes.",
            "$props = \"$dir\\IDE\\bin\\idea.properties\"",
            "if (!(Test-Path \"$persist_dir\\IDE\\bin\\idea.properties\")) {",
            "    info 'Writing idea.properties...'",
            "",
            "    $current = (Split-Path $dir | Join-Path -ChildPath 'current') -replace '\\\\', '/'",
            "",
            "    $CONT = Get-Content $props",
            "    $CONT = $CONT -replace '^#\\s*(idea.config.path=).*$', \"`$1$current/profile/config\"",
            "    $CONT = $CONT -replace '^#\\s*(idea.system.path=).*$', \"`$1$current/profile/system\"",
            "    $CONT = $CONT -replace '^#\\s*(idea.plugins.path=).*$', '$1${idea.config.path}/plugins'",
            "    $CONT = $CONT -replace '^#\\s*(idea.log.path=).*$', '$1${idea.system.path}/log'",
            "",
            "    Set-Content -LiteralPath $props -Value $CONT -Encoding Ascii -Force",
            "}",
            "",
            "# The launcher writes its own copy next to idea.properties; drop them so they never",
            "# leak into persist or get mistaken for user configuration.",
            "Remove-Item \"$dir\\IDE\\bin\\idea.properties.original\", \"$dir\\IDE\\bin\\clion64.exe.vmoptions.original\" -Force -ErrorAction Ignore"
        ]
    },
    "post_install": [
        "$scriptDir = @(\"$bucketsdir\\$bucket\\scripts\\clion\", \"$bucketsdir\\br4ndol\\scripts\\clion\", \"$PWD\\scripts\\clion\") | Where-Object { Test-Path $_ } | Select-Object -First 1",
        "if ($scriptDir) {",
        "    'install-context', 'uninstall-context' | ForEach-Object {",
        "        if (Test-Path \"$scriptDir\\$_.reg\") {",
        "            $content = Get-Content \"$scriptDir\\$_.reg\"",
        "            $exe = \"$dir\\IDE\\bin\\clion64.exe\".Replace('\\', '\\\\')",
        "            $content = $content.Replace('$clion', $exe)",
        "            if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "            Set-Content \"$dir\\$_.reg\" $content -Encoding Ascii -Force",
        "        }",
        "    }",
        "}"
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\clion64.exe.vmoptions",
        "profile"
    ],
    "uninstaller": {
        "script": [
            "# Uninstaller script is only executed by Scoop during 'scoop uninstall', never during update.",
            "if (Test-Path \"$dir\\uninstall-context.reg\") { reg import \"$dir\\uninstall-context.reg\" *> $null }",
            "",
            "# Remove the Junction link; the actual data in 'persist' stays untouched unless 'scoop uninstall -p' is run.",
            "$daemon = \"$env:LOCALAPPDATA\\JetBrains\\Daemon\"",
            "$item = Get-Item -Path $daemon -Force -ErrorAction Ignore",
            "if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { [IO.Directory]::Delete($daemon) }",
            "",
            "# If the JetBrains folder in LocalAppData is now empty, clean it up as well.",
            "$parent = \"$env:LOCALAPPDATA\\JetBrains\"",
            "if ((Test-Path $parent) -and !(Get-ChildItem $parent -Force)) { Remove-Item $parent -Force -ErrorAction Ignore }"
        ]
    },
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=CL&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://download.jetbrains.com/cpp/CLion-$matchVer.win.zip",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
