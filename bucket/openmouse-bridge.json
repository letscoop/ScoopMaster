{
    "version": "1.0.0-beta.18",
    "description": "Native HID and desktop companion for the OpenMouse web control panel",
    "homepage": "https://github.com/OpenMouse-Project/OpenMouse-Bridge",
    "license": "MIT",
    "notes": [
        "Exit OpenMouse Bridge from the tray before updating or uninstalling.",
        "Keep automatic updates disabled in the tray panel and use 'scoop update openmouse-bridge' instead."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenMouse-Project/OpenMouse-Bridge/releases/download/v1.0.0-beta.18/openmouse-bridge-windows-x64.zip",
            "hash": "6fc00caedda5a1ea6c610838a406c79f51aff0cffea4a323faa01115c90f0338"
        }
    },
    "bin": "openmouse-bridge.exe",
    "shortcuts": [
        [
            "openmouse-bridge.exe",
            "OpenMouse Bridge"
        ]
    ],
    "pre_install": [
        "Write-Host ''",
        "$configDir = \"$env:APPDATA\\OpenMouse\\OpenMouse Bridge\\config\"",
        "$persistDataDir = \"$persist_dir\\data\"",
        "New-Item -Path $persistDataDir -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "$existingItem = Get-Item -LiteralPath $configDir -Force -ErrorAction SilentlyContinue",
        "if ($existingItem -and ($existingItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "    if ($existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq $persistDataDir) {",
        "        return",
        "    }",
        "    throw \"Cannot persist OpenMouse Bridge configuration: '$configDir' is an unsupported link or points to another directory.\"",
        "}",
        "if ($existingItem -and !$existingItem.PSIsContainer) {",
        "    throw \"Cannot persist OpenMouse Bridge configuration: '$configDir' is not a directory.\"",
        "}",
        "if ($existingItem) {",
        "    info \"Moving existing OpenMouse Bridge configuration from '$configDir' to '$persistDataDir'...\"",
        "    Get-ChildItem -LiteralPath $configDir -Force -ErrorAction Stop | Move-Item -Destination $persistDataDir -ErrorAction Stop",
        "    [IO.Directory]::Delete($configDir)",
        "}",
        "New-Item -Path (Split-Path -Parent $configDir) -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "info \"Creating OpenMouse Bridge configuration junction from '$configDir' to '$persistDataDir'...\"",
        "New-Item -Path $configDir -ItemType Junction -Target $persistDataDir -ErrorAction Stop | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $configDir = \"$env:APPDATA\\OpenMouse\\OpenMouse Bridge\\config\"",
            "    $existingItem = Get-Item -LiteralPath $configDir -Force -ErrorAction SilentlyContinue",
            "    if ($existingItem -and $existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq \"$persist_dir\\data\") {",
            "        info \"Removing OpenMouse Bridge configuration junction at '$configDir'...\"",
            "        [IO.Directory]::Delete($configDir)",
            "    }",
            "    $keys = @(",
            "        'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run',",
            "        'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run'",
            "    )",
            "    foreach ($key in $keys) {",
            "        Remove-ItemProperty -Path $key -Name 'OpenMouse Bridge' -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/OpenMouse-Project/OpenMouse-Bridge/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(.+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/OpenMouse-Project/OpenMouse-Bridge/releases/download/v$version/openmouse-bridge-windows-x64.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/OpenMouse-Project/OpenMouse-Bridge/releases/tags/v$version",
            "jp": "$..assets[?(@.browser_download_url == '$url')].digest"
        }
    }
}
